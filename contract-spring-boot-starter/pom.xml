<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>media.barney</groupId>
    <artifactId>contract-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>contract-spring-boot-starter</artifactId>
  <name>contract-spring-boot-starter</name>
  <description>Spring Boot dependency-management wrapper for contract-core.</description>

  <dependencies>
    <dependency>
      <groupId>media.barney</groupId>
      <artifactId>contract-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <contract.version>${project.version}</contract.version>
            <maven.dependency.plugin.version>${maven.dependency.plugin.version}</maven.dependency.plugin.version>
            <maven.install.plugin.version>${maven.install.plugin.version}</maven.install.plugin.version>
            <reactor.root>${maven.multiModuleProjectDirectory}</reactor.root>
            <spring.boot.35.version>${spring.boot.35.version}</spring.boot.35.version>
            <spring.boot.40.version>${spring.boot.40.version}</spring.boot.40.version>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <id>spring-boot-dependency-smoke-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
